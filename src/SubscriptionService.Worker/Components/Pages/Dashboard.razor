@page "/"
@implements IAsyncDisposable
@using Microsoft.JSInterop

<PageTitle>Dashboard</PageTitle>

<section class="hero dashboard-hero">
    <div class="hero-copy">
        <p class="eyebrow">Operations</p>
        <h1>Subscription operations</h1>
        <p class="muted">
            Monitor and control configured subscriptions.
        </p>
    </div>

    <div class="hero-actions">
        <button class="button button-secondary" @onclick="() => ReloadAsync()" disabled="@_loading">↻ Refresh</button>
        <a class="button button-primary" href="/admin/subscriptions/new">＋ New subscription</a>
    </div>
</section>

@if (_loading)
{
    <section class="panel loading-panel">
        <div class="skeleton-line w-40"></div>
        <div class="skeleton-line w-70"></div>
        <div class="skeleton-line w-55"></div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel alert-panel">
        <p class="eyebrow">Unable to load</p>
        <h2>We couldn’t build the dashboard right now.</h2>
        <p class="muted">@_error</p>
    </section>
}
else if (_model is not null)
{
    <section class="dashboard-summary panel" aria-label="Subscription overview">
        <div class="dashboard-attention">
            <div class="attention-icon @(HasAttention ? "attention-needed" : "attention-clear")">@(HasAttention ? "!" : "✓")</div>
            <div class="attention-copy">
                <strong>@AttentionHeading</strong>
                <span class="muted">@AttentionDetail</span>
            </div>
            @if (_model.ParkedEvents > 0)
            {
                <button class="button button-secondary button-compact attention-action" @onclick="ShowAffectedSubscriptions">Show affected subscriptions</button>
            }
        </div>
        <div class="summary-metrics">
            <div class="summary-metric"><strong>@_model.TotalSubscriptions</strong><span>Subscriptions</span></div>
            <div class="summary-metric"><strong>@_model.RunningSubscriptions</strong><span>Running</span></div>
            <div class="summary-metric"><strong>@_model.ReplayingSubscriptions</strong><span>Replaying</span></div>
            <div class="summary-metric summary-metric-attention"><strong>@_model.ParkedEvents</strong><span>Parked</span></div>
        </div>
    </section>

    <section class="panel subscriptions-panel">
        <div class="panel-header">
            <div>
                <h2>Subscriptions</h2>
            </div>
            <div class="panel-header-copy">
                <span>@FilteredSubscriptions.Count() of @_model.Subscriptions.Count configured</span>
            </div>
        </div>

        <div class="subscription-filters">
            <input type="search" class="input" placeholder="Search by index, endpoint or tag…" @bind="_search" @bind:event="oninput" />
            <select class="input input-filter" @bind="_statusFilter">
                <option value="All">All runtime states</option>
                <option value="Running">Running</option>
                <option value="Stopped">Stopped</option>
                <option value="Faulted">Faulted</option>
            </select>
            <label class="parked-filter">
                <input type="checkbox" @bind="_parkedOnly" />
                Parked only
            </label>
            <select class="input input-filter" @bind="_sortBy">
                <option value="Activity">Sort: activity</option>
                <option value="Name">Sort: name</option>
                <option value="Parked">Sort: parked events</option>
            </select>
        </div>

        @if (_model.Subscriptions.Count == 0)
        {
            <div class="empty-state compact">
                <h3>No subscriptions yet.</h3>
                <p class="muted">Create the first subscription to start tracking status and replay state.</p>
                <a class="button button-primary" href="/admin/subscriptions/new">Create subscription</a>
            </div>
        }
        else
        {
            <div class="subscription-groups">
                @foreach (var group in SubscriptionsByEndpoint)
                {
                    <section class="endpoint-group">
                        <header class="endpoint-group-header">
                            <button type="button" class="endpoint-group-toggle" aria-expanded="@(!IsEndpointCollapsed(group.Key))" aria-label="@EndpointGroupActionLabel(group)" @onclick="() => ToggleEndpointGroup(group.Key)">
                                <span class="endpoint-group-heading">
                                    <span class="eyebrow">Endpoint</span>
                                    <span class="endpoint-group-name" role="heading" aria-level="3">@group.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(group.Url))
                                    {
                                        <span class="endpoint-group-url">@group.Url</span>
                                    }
                                </span>
                                <span class="endpoint-group-count">@group.Subscriptions.Count @(group.Subscriptions.Count == 1 ? "subscription" : "subscriptions")</span>
                                <span class="endpoint-group-chevron" aria-hidden="true">@(IsEndpointCollapsed(group.Key) ? "▸" : "▾")</span>
                            </button>
                        </header>
                        <div class="subscription-list" hidden="@IsEndpointCollapsed(group.Key)">
                @foreach (var item in group.Subscriptions)
                {
                    <article class="subscription-row">
                        <div class="subscription-identity">
                            <a class="subscription-name" href="@($"/admin/subscriptions/{item.SubscriptionId}")">@FriendlyName(item)</a>
                            @if (IsIdVisible(item.SubscriptionId))
                            {
                                <div class="generated-id-value" title="@item.SubscriptionId">@item.SubscriptionId</div>
                            }
                        </div>
                        <div class="subscription-status-stat">
                            <span class="subscription-stat-label">Runtime</span>
                            <span class="runtime-state @GetRuntimeClass(item)">@GetRuntimeState(item)</span>
                        </div>
                        <div class="subscription-status-stat delivery-health-stat">
                            <span class="subscription-stat-label">Delivery health</span>
                            <span class="delivery-health @(item.ParkedEventCount > 0 ? "delivery-health-warning" : "")">@(item.ParkedEventCount > 0 ? "Needs attention" : "No parked events")</span>
                        </div>
                        <div class="subscription-stat progress-stat"><span>Progress</span><strong>@(item.ProgressDisplay ?? "No count yet")</strong><div class="progress-bar"><span style="@GetProgressStyle(item.ProgressDisplay)"></span></div></div>
                        <div class="subscription-stat parked-stat">
                            <span>Parked events</span>
                            @if (item.ParkedEventCount > 0)
                            {
                                <a class="parked-count-link" href="@($"/admin/subscriptions/{item.SubscriptionId}#parked-events")" aria-label="Review @item.ParkedEventCount parked events for @FriendlyName(item)">@item.ParkedEventCount</a>
                            }
                            else
                            {
                                <strong>0</strong>
                            }
                        </div>
                        <div class="subscription-actions">
                            <button class="button button-primary button-compact" @onclick="() => ToggleEnabledAsync(item)" disabled="@_busyIds.Contains(item.SubscriptionId)">@(item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy ? "Stop" : "Start")</button>
                            <button type="button" class="button button-ghost button-compact actions-menu-button" aria-haspopup="true" aria-expanded="@IsMenuOpen(item.SubscriptionId)" aria-label="Actions for @FriendlyName(item)" @onclick="() => ToggleMenu(item.SubscriptionId)">Actions <span aria-hidden="true">▾</span></button>
                            @if (_openMenuId == item.SubscriptionId)
                            {
                                <div class="subscription-menu" role="group" aria-label="Actions for @FriendlyName(item)">
                                    <a href="@($"/admin/subscriptions/{item.SubscriptionId}/edit")">Edit subscription</a>
                                    <button type="button" @onclick="() => ToggleId(item.SubscriptionId)">
                                        @(IsIdVisible(item.SubscriptionId) ? "Hide generated ID" : "View generated ID")
                                    </button>
                                    <button type="button" @onclick="() => CopySubscriptionIdAsync(item.SubscriptionId)">Copy subscription ID</button>
                                    <button type="button" @onclick="() => TriggerReplayFromMenuAsync(item.SubscriptionId)">Replay now</button>
                                    <button type="button" class="danger-menu-item" @onclick="() => DeleteSubscriptionAsync(item.SubscriptionId)">@(_pendingDeleteId == item.SubscriptionId ? "Confirm delete" : "Delete subscription")</button>
                                </div>
                            }
                        </div>
                    </article>
                }
                        </div>
                    </section>
                }
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_toast))
    {
        <section class="panel toast-panel">
            <p class="eyebrow">Update</p>
            <p>@_toast</p>
        </section>
    }
}

@code {
    private DashboardViewModel? _model;
    private bool _loading = true;
    private string? _error;
    private string? _toast;
    private string? _pendingDeleteId;
    private readonly HashSet<string> _busyIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _refreshCts = new();
    private Task? _refreshLoop;

    [Inject]
    private SubscriptionAdminService Admin { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    private string _search = string.Empty;
    private string _statusFilter = "All";
    private string _sortBy = "Activity";
    private bool _parkedOnly;
    private string? _openMenuId;
    private string? _visibleId;
    private readonly HashSet<string> _collapsedEndpointGroupKeys = new(StringComparer.Ordinal);

    private IEnumerable<DashboardSubscriptionCard> FilteredSubscriptions => (_model?.Subscriptions ?? [])
        .Where(item => string.IsNullOrWhiteSpace(_search) ||
            $"{item.SubscriptionId} {item.SecondaryIndexName} {item.EndpointName} {item.EndpointUrl} {item.Tag}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(item => string.Equals(_statusFilter, "All", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(GetRuntimeState(item), _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(item => !_parkedOnly || item.ParkedEventCount > 0)
        .OrderBy(item => _sortBy switch
        {
            "Name" => FriendlyName(item),
            "Parked" => item.ParkedEventCount.ToString("D10", CultureInfo.InvariantCulture),
            _ => item.LatestParkedAt.HasValue ? "0" : "1"
        })
        .ThenBy(item => FriendlyName(item));

    private IEnumerable<EndpointSubscriptionGroup> SubscriptionsByEndpoint => FilteredSubscriptions
        .GroupBy(item => item.EndpointId is int endpointId ? $"endpoint:{endpointId}" : $"url:{item.EndpointUrl}", StringComparer.Ordinal)
        .Select(group =>
        {
            var firstSubscription = group.First();
            return new EndpointSubscriptionGroup(
                group.Key,
                string.IsNullOrWhiteSpace(firstSubscription.EndpointName) ? "Unassigned endpoint" : firstSubscription.EndpointName,
                firstSubscription.EndpointUrl,
                group.ToArray());
        })
        .OrderBy(group => group.Name, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(group => group.Name, StringComparer.CurrentCulture)
        .ThenBy(group => group.Url, StringComparer.OrdinalIgnoreCase);

    private string EndpointGroupActionLabel(EndpointSubscriptionGroup group) =>
        $"{(IsEndpointCollapsed(group.Key) ? "Expand" : "Collapse")} {group.Name}, {group.Subscriptions.Count} {(group.Subscriptions.Count == 1 ? "subscription" : "subscriptions")}";

    private bool IsEndpointCollapsed(string key) => _collapsedEndpointGroupKeys.Contains(key);

    private void ToggleEndpointGroup(string key)
    {
        if (!_collapsedEndpointGroupKeys.Add(key))
        {
            _collapsedEndpointGroupKeys.Remove(key);
        }
    }

    private int FaultedWorkerCount => _model?.Subscriptions.Count(item => GetRuntimeState(item) == "Faulted") ?? 0;
    private bool HasAttention => (_model?.ParkedEvents ?? 0) > 0 || FaultedWorkerCount > 0;

    private string AttentionHeading => _model?.ParkedEvents > 0
        ? $@"{_model.ParkedEvents} parked events need attention"
        : FaultedWorkerCount > 0
            ? $@"{FaultedWorkerCount} workers need attention"
            : "All subscriptions are healthy";

    private string AttentionDetail => _model?.ParkedEvents > 0
        ? "Delivery failures are isolated to the subscriptions that need attention."
        : FaultedWorkerCount > 0
            ? "Open the affected subscriptions to review worker faults."
            : "No parked events or failed workers detected · Updated just now";

    private void ShowAffectedSubscriptions()
    {
        _parkedOnly = true;
        _statusFilter = "All";
    }

    private static string GetRuntimeState(DashboardSubscriptionCard item) =>
        string.Equals(item.Health, "Faulted", StringComparison.OrdinalIgnoreCase)
            ? "Faulted"
            : item.IsRunning ? "Running" : "Stopped";

    private static string GetRuntimeClass(DashboardSubscriptionCard item) => GetRuntimeState(item).ToLowerInvariant() switch
    {
        "running" => "runtime-running",
        "faulted" => "runtime-faulted",
        _ => "runtime-stopped"
    };

    private static string FriendlyName(DashboardSubscriptionCard item)
    {
        var index = string.IsNullOrWhiteSpace(item.SecondaryIndexName) ? "Subscription" : item.SecondaryIndexName;
        var endpoint = item.EndpointUrl.TrimEnd('/').Split('/').LastOrDefault() ?? "Endpoint";
        return $@"{index} → {endpoint}";
    }

    private bool IsIdVisible(string subscriptionId) => string.Equals(_visibleId, subscriptionId, StringComparison.OrdinalIgnoreCase);

    private void ToggleId(string subscriptionId)
    {
        _visibleId = IsIdVisible(subscriptionId) ? null : subscriptionId;
        _openMenuId = null;
    }

    private bool IsMenuOpen(string subscriptionId) => string.Equals(_openMenuId, subscriptionId, StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu(string subscriptionId) => _openMenuId = IsMenuOpen(subscriptionId) ? null : subscriptionId;

    private async Task CopySubscriptionIdAsync(string subscriptionId)
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", subscriptionId);
        _openMenuId = null;
        _toast = "Generated subscription ID copied.";
    }

    private async Task TriggerReplayFromMenuAsync(string subscriptionId)
    {
        _openMenuId = null;
        await TriggerReplayAsync(subscriptionId);
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _refreshLoop = Task.Run(RefreshLoopAsync);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
        }
        _error = null;

        try
        {
            _model = await Admin.GetDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (showLoading)
            {
                _loading = false;
            }
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync(showLoading: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task TriggerReplayAsync(string subscriptionId)
    {
        if (!_busyIds.Add(subscriptionId))
        {
            return;
        }

        try
        {
            var result = await Admin.ReplayAsync(subscriptionId);
            _toast = result.Message;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(subscriptionId);
        }
    }

    private async Task ToggleEnabledAsync(DashboardSubscriptionCard item)
    {
        if (!_busyIds.Add(item.SubscriptionId))
        {
            return;
        }

        try
        {
            var updated = item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy
                ? await Admin.StopAsync(item.SubscriptionId)
                : await Admin.StartAsync(item.SubscriptionId);
            _toast = updated
                ? $"{item.SubscriptionId} is now {(item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy ? "stopped" : "started")}."
                : "Subscription not found.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(item.SubscriptionId);
        }
    }

    private async Task DeleteSubscriptionAsync(string subscriptionId)
    {
        if (!string.Equals(_pendingDeleteId, subscriptionId, StringComparison.OrdinalIgnoreCase))
        {
            _pendingDeleteId = subscriptionId;
            _toast = $"Ready to delete {subscriptionId}. Click delete again to confirm.";
            return;
        }

        if (!_busyIds.Add(subscriptionId))
        {
            return;
        }

        try
        {
            var deleted = await Admin.DeleteAsync(subscriptionId);
            _toast = deleted ? $"Deleted {subscriptionId}." : "Subscription not found.";
            _pendingDeleteId = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(subscriptionId);
        }
    }

    private static string GetProgressStyle(string? progressDisplay)
    {
        if (string.IsNullOrWhiteSpace(progressDisplay))
        {
            return "width: 16%;";
        }

        var percentText = progressDisplay.Split('%', 2)[0];
        if (double.TryParse(percentText, NumberStyles.Float, CultureInfo.CurrentCulture, out var percent) ||
            double.TryParse(percentText, NumberStyles.Float, CultureInfo.InvariantCulture, out percent))
        {
            return $"width: {Math.Clamp(percent, 0, 100):0.##}%;";
        }

        return "width: 24%;";
    }

    public async ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _refreshCts.Dispose();
    }

    private sealed record EndpointSubscriptionGroup(
        string Key,
        string Name,
        string Url,
        IReadOnlyList<DashboardSubscriptionCard> Subscriptions);
}
