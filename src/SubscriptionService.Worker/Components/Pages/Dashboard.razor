@page "/"
@implements IAsyncDisposable
@using Microsoft.JSInterop

<PageTitle>Dashboard</PageTitle>

<section class="hero dashboard-hero">
    <div class="hero-copy">
        <p class="eyebrow">Operations</p>
        <h1>Subscription operations</h1>
        <p class="muted">
            Monitor and control configured subscriptions.
        </p>
    </div>

    <div class="hero-actions">
        <button class="button button-secondary" @onclick="() => ReloadAsync()" disabled="@_loading">↻ Refresh</button>
        <a class="button button-primary" href="/admin/subscriptions/new">＋ New subscription</a>
    </div>
</section>

@if (_loading)
{
    <section class="panel loading-panel">
        <div class="skeleton-line w-40"></div>
        <div class="skeleton-line w-70"></div>
        <div class="skeleton-line w-55"></div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel alert-panel">
        <p class="eyebrow">Unable to load</p>
        <h2>We couldn’t build the dashboard right now.</h2>
        <p class="muted">@_error</p>
    </section>
}
else if (_model is not null)
{
    <section class="dashboard-attention panel">
        <div class="attention-icon">✓</div>
        <div>
            <strong>@AttentionHeading</strong>
            <span class="muted">@AttentionDetail</span>
        </div>
    </section>

    <section class="stats-grid">
        <article class="stat-card panel">
            <span class="stat-label">Subscriptions</span>
            <strong>@_model.TotalSubscriptions</strong>
            <span class="stat-foot">Configured in the service</span>
        </article>
        <article class="stat-card panel">
            <span class="stat-label">Running</span>
            <strong>@_model.RunningSubscriptions</strong>
            <span class="stat-foot">Background workers active</span>
        </article>
        <article class="stat-card panel">
            <span class="stat-label">Replaying</span>
            <strong>@_model.ReplayingSubscriptions</strong>
            <span class="stat-foot">Current replay sessions</span>
        </article>
        <article class="stat-card panel">
            <span class="stat-label">Parked events</span>
            <strong>@_model.ParkedEvents</strong>
            <span class="stat-foot">Awaiting attention</span>
        </article>
    </section>

    <section class="panel subscriptions-panel">
        <div class="panel-header">
            <div>
                <h2>Subscriptions</h2>
            </div>
            <div class="panel-header-copy">
                <span>@FilteredSubscriptions.Count() of @_model.Subscriptions.Count configured</span>
            </div>
        </div>

        <div class="subscription-filters">
            <input type="search" class="input" placeholder="Search by index, endpoint or tag…" @bind="_search" @bind:event="oninput" />
            <select class="input input-filter" @bind="_statusFilter">
                <option value="All">All statuses</option>
                <option value="Healthy">Healthy</option>
                <option value="Replaying">Replaying</option>
                <option value="Stopped">Stopped</option>
                <option value="Faulted">Faulted</option>
            </select>
            <label class="parked-filter">
                <input type="checkbox" @bind="_parkedOnly" />
                Parked only
            </label>
            <select class="input input-filter" @bind="_sortBy">
                <option value="Activity">Sort: activity</option>
                <option value="Name">Sort: name</option>
                <option value="Parked">Sort: parked events</option>
            </select>
        </div>

        @if (_model.Subscriptions.Count == 0)
        {
            <div class="empty-state compact">
                <h3>No subscriptions yet.</h3>
                <p class="muted">Create the first subscription to start tracking status and replay state.</p>
                <a class="button button-primary" href="/admin/subscriptions/new">Create subscription</a>
            </div>
        }
        else
        {
            <div class="subscription-list">
                @foreach (var item in FilteredSubscriptions)
                {
                    <article class="subscription-row">
                        <div class="subscription-identity">
                            <a class="subscription-name" href="@($"/admin/subscriptions/{item.SubscriptionId}")">@FriendlyName(item)</a>
                            <div class="subscription-details">Tag: @item.Tag <span>·</span> Endpoint: @item.EndpointUrl</div>
                            <div class="generated-id-actions">
                                <button class="link-button" @onclick="() => ToggleId(item.SubscriptionId)">
                                    @(IsIdVisible(item.SubscriptionId) ? "Hide generated ID" : "View generated ID")
                                </button>
                                <button class="button button-ghost button-compact" @onclick="() => CopySubscriptionIdAsync(item.SubscriptionId)">Copy</button>
                            </div>
                            @if (IsIdVisible(item.SubscriptionId))
                            {
                                <div class="generated-id-value" title="@item.SubscriptionId">@item.SubscriptionId</div>
                            }
                            <div class="subscription-status"><span class="@GetHealthClass(item.Health)">@item.Health</span><span>·</span>@(item.IsRunning ? "Running" : "Stopped")</div>
                            <div class="subscription-event-logging"><span class="@(item.EnableEventLogging ? "badge badge-success" : "badge badge-muted")">Event logging: @(item.EnableEventLogging ? "On" : "Off")</span></div>
                        </div>
                        <div class="subscription-stat"><span>Rate</span><strong>@FormatRate(item.SubscriptionId)</strong></div>
                        <div class="subscription-stat"><span>Progress</span><strong>@(item.ProgressDisplay ?? "No count yet")</strong><div class="progress-bar"><span style="@GetProgressStyle(item.ProgressDisplay)"></span></div></div>
                        <div class="subscription-stat"><span>Parked</span><strong>@item.ParkedEventCount</strong><small>@DisplayDate(item.LatestParkedAt)</small></div>
                        <div class="subscription-actions">
                            <a class="button button-ghost button-compact" href="@($"/admin/subscriptions/{item.SubscriptionId}")">View</a>
                            <a class="button button-ghost button-compact" href="@($"/admin/subscriptions/{item.SubscriptionId}/edit")">Edit</a>
                            <button class="button button-secondary button-compact" @onclick="() => ToggleEnabledAsync(item)" disabled="@_busyIds.Contains(item.SubscriptionId)">@(item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy ? "Stop" : "Start")</button>
                            <button type="button" class="button button-ghost button-compact more-button" aria-label="More actions" @onclick="() => ToggleMenu(item.SubscriptionId)">•••</button>
                            @if (_openMenuId == item.SubscriptionId)
                            {
                                <div class="subscription-menu">
                                    <button type="button" @onclick="() => TriggerReplayAsync(item.SubscriptionId)">Replay now</button>
                                    <button type="button" class="danger-menu-item" @onclick="() => DeleteSubscriptionAsync(item.SubscriptionId)">@(_pendingDeleteId == item.SubscriptionId ? "Confirm delete" : "Delete subscription")</button>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_toast))
    {
        <section class="panel toast-panel">
            <p class="eyebrow">Update</p>
            <p>@_toast</p>
        </section>
    }
}

@code {
    private DashboardViewModel? _model;
    private bool _loading = true;
    private string? _error;
    private string? _toast;
    private string? _pendingDeleteId;
    private readonly HashSet<string> _busyIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, RateSample> _rateSamples = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, double> _rates = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _refreshCts = new();
    private Task? _refreshLoop;

    [Inject]
    private SubscriptionAdminService Admin { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    private string _search = string.Empty;
    private string _statusFilter = "All";
    private string _sortBy = "Activity";
    private bool _parkedOnly;
    private string? _openMenuId;
    private string? _visibleId;

    private IEnumerable<DashboardSubscriptionCard> FilteredSubscriptions => (_model?.Subscriptions ?? [])
        .Where(item => string.IsNullOrWhiteSpace(_search) ||
            $"{item.SubscriptionId} {item.SecondaryIndexName} {item.EndpointUrl} {item.Tag}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(item => string.Equals(_statusFilter, "All", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(item.Health, _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(item => !_parkedOnly || item.ParkedEventCount > 0)
        .OrderBy(item => _sortBy switch
        {
            "Name" => FriendlyName(item),
            "Parked" => item.ParkedEventCount.ToString("D10", CultureInfo.InvariantCulture),
            _ => item.LatestParkedAt.HasValue ? "0" : "1"
        })
        .ThenBy(item => FriendlyName(item));

    private string AttentionHeading => _model?.ParkedEvents > 0
        ? $@"{_model.ParkedEvents} parked events need attention"
        : "All subscriptions are healthy";

    private string AttentionDetail => _model?.ParkedEvents > 0
        ? "Review parked events from the affected subscription details."
        : "No parked events or failed workers detected · Updated just now";

    private static string FriendlyName(DashboardSubscriptionCard item)
    {
        var index = string.IsNullOrWhiteSpace(item.SecondaryIndexName) ? "Subscription" : item.SecondaryIndexName;
        var endpoint = item.EndpointUrl.TrimEnd('/').Split('/').LastOrDefault() ?? "Endpoint";
        return $@"{index} → {endpoint}";
    }

    private bool IsIdVisible(string subscriptionId) => string.Equals(_visibleId, subscriptionId, StringComparison.OrdinalIgnoreCase);

    private void ToggleId(string subscriptionId) => _visibleId = IsIdVisible(subscriptionId) ? null : subscriptionId;

    private void ToggleMenu(string subscriptionId) => _openMenuId = string.Equals(_openMenuId, subscriptionId, StringComparison.OrdinalIgnoreCase) ? null : subscriptionId;

    private async Task CopySubscriptionIdAsync(string subscriptionId)
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", subscriptionId);
        _toast = "Generated subscription ID copied.";
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _refreshLoop = Task.Run(RefreshLoopAsync);
    }

    private async Task ReloadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
        }
        _error = null;

        try
        {
            _model = await Admin.GetDashboardAsync();
            UpdateRates(_model);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (showLoading)
            {
                _loading = false;
            }
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync(showLoading: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task TriggerReplayAsync(string subscriptionId)
    {
        if (!_busyIds.Add(subscriptionId))
        {
            return;
        }

        try
        {
            var result = await Admin.ReplayAsync(subscriptionId);
            _toast = result.Message;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(subscriptionId);
        }
    }

    private async Task ToggleEnabledAsync(DashboardSubscriptionCard item)
    {
        if (!_busyIds.Add(item.SubscriptionId))
        {
            return;
        }

        try
        {
            var updated = item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy
                ? await Admin.StopAsync(item.SubscriptionId)
                : await Admin.StartAsync(item.SubscriptionId);
            _toast = updated
                ? $"{item.SubscriptionId} is now {(item.Enabled && item.OperationalState == SubscriptionOperationalState.Healthy ? "stopped" : "started")}."
                : "Subscription not found.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(item.SubscriptionId);
        }
    }

    private async Task DeleteSubscriptionAsync(string subscriptionId)
    {
        if (!string.Equals(_pendingDeleteId, subscriptionId, StringComparison.OrdinalIgnoreCase))
        {
            _pendingDeleteId = subscriptionId;
            _toast = $"Ready to delete {subscriptionId}. Click delete again to confirm.";
            return;
        }

        if (!_busyIds.Add(subscriptionId))
        {
            return;
        }

        try
        {
            var deleted = await Admin.DeleteAsync(subscriptionId);
            _toast = deleted ? $"Deleted {subscriptionId}." : "Subscription not found.";
            _pendingDeleteId = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busyIds.Remove(subscriptionId);
        }
    }

    private void UpdateRates(DashboardViewModel model)
    {
        var now = DateTimeOffset.UtcNow;
        var activeIds = model.Subscriptions.Select(x => x.SubscriptionId).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var item in model.Subscriptions)
        {
            if (_rateSamples.TryGetValue(item.SubscriptionId, out var previous))
            {
                var elapsedSeconds = (now - previous.Timestamp).TotalSeconds;
                if (elapsedSeconds > 0)
                {
                    _rates[item.SubscriptionId] = Math.Max(0, (item.ProcessedCount - previous.ProcessedCount) / elapsedSeconds);
                }
            }

            _rateSamples[item.SubscriptionId] = new RateSample(item.ProcessedCount, now);
        }

        foreach (var staleId in _rateSamples.Keys.Where(id => !activeIds.Contains(id)).ToArray())
        {
            _rateSamples.Remove(staleId);
            _rates.Remove(staleId);
        }
    }

    private string FormatRate(string subscriptionId) =>
        _rates.TryGetValue(subscriptionId, out var rate)
            ? $"{rate.ToString("N1", CultureInfo.CurrentCulture)} msg/s"
            : "—";

    private static string GetHealthClass(string health) => health.ToLowerInvariant() switch
    {
        "healthy" => "badge badge-success",
        "replaying" => "badge badge-warning",
        "stopped" => "badge badge-muted",
        "faulted" => "badge badge-danger",
        _ => "badge badge-info"
    };

    private static string GetProgressStyle(string? progressDisplay)
    {
        if (string.IsNullOrWhiteSpace(progressDisplay))
        {
            return "width: 16%;";
        }

        var percentText = progressDisplay.Split('%', 2)[0];
        if (double.TryParse(percentText, NumberStyles.Float, CultureInfo.CurrentCulture, out var percent) ||
            double.TryParse(percentText, NumberStyles.Float, CultureInfo.InvariantCulture, out percent))
        {
            return $"width: {Math.Clamp(percent, 0, 100):0.##}%;";
        }

        return "width: 24%;";
    }

    private static string DisplayValue(long? value) => value.HasValue ? value.Value.ToString("N0", CultureInfo.InvariantCulture) : "n/a";

    private static string DisplayDate(DateTimeOffset? value) => value is null
        ? "n/a"
        : value.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture);

    public async ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _refreshCts.Dispose();
    }

    private sealed record RateSample(long ProcessedCount, DateTimeOffset Timestamp);
}
