@page "/diagnostics/connections"
@implements IAsyncDisposable

<PageTitle>Connection diagnostics</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Diagnostics</p>
        <h1>Connection diagnostics</h1>
        <p class="muted">
            View the live subscription connections and the independent count subscriptions side by side.
        </p>
    </div>

    <div class="hero-actions">
        <a class="button button-secondary" href="/">Back to dashboard</a>
        <a class="button button-secondary" href="/admin/subscriptions">Manage subscriptions</a>
    </div>
</section>

<section class="stats-grid three-up">
    <article class="stat-card panel">
        <span class="stat-label">Live connections</span>
        <strong>@_liveRows.Count</strong>
        <span class="stat-foot">Main subscription runtimes currently in memory</span>
    </article>
    <article class="stat-card panel">
        <span class="stat-label">Live events processed</span>
        <strong>@_liveEventCount.ToString(CultureInfo.InvariantCulture)</strong>
        <span class="stat-foot">Total processed events across the main subscription runtimes</span>
    </article>
    <article class="stat-card panel">
        <span class="stat-label">Count connections</span>
        <strong>@_countRows.Count</strong>
        <span class="stat-foot">Independent count subscriptions currently running</span>
    </article>
    <article class="stat-card panel">
        <span class="stat-label">Count worker</span>
        <strong>@_countWorkerSummary</strong>
        <span class="stat-foot">Configured / attempted / failed independent subscriptions</span>
    </article>
    <article class="stat-card panel">
        <span class="stat-label">Last refresh</span>
        <strong>@_lastRefresh.ToString("HH:mm:ss", CultureInfo.CurrentCulture)</strong>
        <span class="stat-foot">Auto-refreshing every second</span>
    </article>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow">Live</p>
            <h2>Main subscription connections</h2>
        </div>
    </div>

    @if (_liveRows.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No live subscription connections.</h3>
            <p class="muted">The worker may not have started any subscription runtimes yet.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Subscription</th>
                        <th>Processed</th>
                        <th>State</th>
                        <th>Last event</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _liveRows)
                    {
                        <tr>
                            <td>
                                <strong>@row.SubscriptionId</strong>
                            </td>
                            <td>@row.ProcessedCountDisplay</td>
                            <td>
                                <span class="@row.StateClass">@row.State</span>
                                @if (!string.IsNullOrWhiteSpace(row.FailureReason))
                                {
                                    <div class="muted small">@row.FailureReason</div>
                                }
                            </td>
                            <td>
                                <div>@(row.LastEventId ?? "n/a")</div>
                                <div class="muted small">@row.LastStreamName</div>
                                <div class="muted small">@row.LastEventType</div>
                            </td>
                            <td>@row.UpdatedAtDisplay</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow">Count</p>
            <h2>Independent count subscriptions</h2>
        </div>
    </div>

    @if (_countRows.Count == 0)
    {
        <div class="empty-state compact">
            <h3>No count subscriptions yet.</h3>
            <p class="muted">@_countWorkerHint</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Subscription</th>
                        <th>Index</th>
                        <th>State</th>
                        <th>Total count</th>
                        <th>Commit</th>
                        <th>Last event</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _countRows)
                    {
                        <tr>
                            <td><strong>@row.SubscriptionId</strong></td>
                            <td>@row.SecondaryIndexName</td>
                            <td>
                                <span class="@row.StateClass">@row.State</span>
                                @if (row.IsCaughtUp)
                                {
                                    <div class="muted small">Caught up</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.FailureReason))
                                {
                                    <div class="muted small">@row.FailureReason</div>
                                }
                            </td>
                            <td>@row.TotalCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td>@row.CommitPositionDisplay</td>
                            <td>
                                <div>@(row.LastEventId ?? "n/a")</div>
                                <div class="muted small">@row.LastStreamName</div>
                                <div class="muted small">@row.LastEventType</div>
                            </td>
                            <td>@row.UpdatedAtDisplay</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Inject]
    private WorkerRuntimeRegistry RuntimeRegistry { get; set; } = default!;

    [Inject]
    private CountConnectionRegistry CountRegistry { get; set; } = default!;

    [Inject]
    private CountWorkerStatusRegistry CountWorkerRegistry { get; set; } = default!;

    private readonly CancellationTokenSource _refreshCts = new();
    private Task? _refreshLoop;
    private DateTimeOffset _lastRefresh = DateTimeOffset.UtcNow;
    private List<LiveConnectionRow> _liveRows = [];
    private List<CountConnectionRow> _countRows = [];
    private long _liveEventCount;
    private string _countWorkerSummary = "0 / 0 / 0";
    private string _countWorkerHint = "The worker may not have created the count trackers yet.";

    protected override void OnInitialized()
    {
        Refresh();
        _refreshLoop = Task.Run(RefreshLoopAsync);
    }

    private void Refresh()
    {
        _lastRefresh = DateTimeOffset.UtcNow;

        _liveRows = RuntimeRegistry.GetAll()
            .Select(kvp => CreateLiveRow(kvp.Key, kvp.Value))
            .OrderBy(x => x.SubscriptionId, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _liveEventCount = _liveRows.Sum(x => x.ProcessedCount);

        _countRows = CountRegistry.GetAll()
            .Select(CreateCountRow)
            .OrderBy(x => x.SubscriptionId, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var countWorkerSnapshot = CountWorkerRegistry.GetSnapshot();
        _countWorkerSummary = $"{countWorkerSnapshot.ConfiguredSubscriptions} / {countWorkerSnapshot.AttemptedSubscriptions} / {countWorkerSnapshot.FailedSubscriptions}";
        _countWorkerHint = BuildCountWorkerHint(countWorkerSnapshot);
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(() =>
                {
                    Refresh();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static LiveConnectionRow CreateLiveRow(string subscriptionId, SubscriptionRuntime runtime)
    {
        var snapshot = runtime.GetLastDeliverySnapshot();
        return new LiveConnectionRow(
            subscriptionId,
            runtime.GetProcessedCount(),
            snapshot?.EventId ?? "n/a",
            snapshot?.StreamName ?? "n/a",
            snapshot?.EventType ?? "n/a",
            snapshot?.DeliveredAt,
            snapshot?.Status ?? "Idle",
            snapshot?.FailureReason,
            GetStateClass(snapshot?.Status ?? "Idle"));
    }

    private static CountConnectionRow CreateCountRow(CountConnectionSnapshot snapshot) =>
        new(
            snapshot.SubscriptionId,
            snapshot.SecondaryIndexName,
            snapshot.State,
            snapshot.TotalCount,
            snapshot.IsCaughtUp,
            snapshot.LastCommitPosition,
            snapshot.LastEventId,
            snapshot.LastStreamName,
            snapshot.LastEventType,
            snapshot.UpdatedAt,
            snapshot.FailureReason,
            GetStateClass(snapshot.State));

    private static string BuildCountWorkerHint(CountWorkerStatusSnapshot snapshot)
    {
        if (snapshot.ConfiguredSubscriptions == 0)
        {
            return "No enabled subscriptions with a secondary index were found, so the independent count worker had nothing to start.";
        }

        if (snapshot.AttemptedSubscriptions == 0)
        {
            return "The count worker has not attempted any independent subscriptions yet. That usually means the host has not started it or startup failed before the first subscription was created.";
        }

        if (snapshot.FailedSubscriptions > 0)
        {
            return string.IsNullOrWhiteSpace(snapshot.LastError)
                ? "The count worker attempted subscriptions but at least one failed."
                : $"The count worker attempted subscriptions and at least one failed: {snapshot.LastError}";
        }

        return "The count worker has started independent subscriptions. If the table is still empty, refresh again in a second or two.";
    }

    private static string GetStateClass(string state) => state.ToLowerInvariant() switch
    {
        "caughtup" => "badge badge-success",
        "live" => "badge badge-info",
        "counting" => "badge badge-warning",
        "starting" => "badge badge-muted",
        "stopped" => "badge badge-muted",
        "faulted" => "badge badge-danger",
        _ => "badge badge-info"
    };

    private sealed record LiveConnectionRow(
        string SubscriptionId,
        long ProcessedCount,
        string LastEventId,
        string LastStreamName,
        string LastEventType,
        DateTimeOffset? LastEventAt,
        string State,
        string? FailureReason,
        string StateClass)
    {
        public string UpdatedAtDisplay => LastEventAt is null ? "n/a" : LastEventAt.Value.ToString("HH:mm:ss", CultureInfo.CurrentCulture);
        public string ProcessedCountDisplay => ProcessedCount.ToString(CultureInfo.CurrentCulture);
    }

    private sealed record CountConnectionRow(
        string SubscriptionId,
        string SecondaryIndexName,
        string State,
        long TotalCount,
        bool IsCaughtUp,
        long? LastCommitPosition,
        string? LastEventId,
        string? LastStreamName,
        string? LastEventType,
        DateTimeOffset UpdatedAt,
        string? FailureReason,
        string StateClass)
    {
        public string CommitPositionDisplay => LastCommitPosition?.ToString(CultureInfo.CurrentCulture) ?? "n/a";
        public string UpdatedAtDisplay => UpdatedAt.ToString("HH:mm:ss", CultureInfo.CurrentCulture);
    }

    public async ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _refreshCts.Dispose();
    }
}
