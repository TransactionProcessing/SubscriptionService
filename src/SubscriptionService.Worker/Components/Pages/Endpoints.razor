@page "/admin/endpoints"
@inject SubscriptionAdminService Admin

<PageTitle>Endpoint management</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Configuration</p>
        <h1>Endpoint management</h1>
        <p class="muted">Manage reusable delivery targets, including their authentication settings.</p>
    </div>
    <div class="hero-actions"><NavLink class="button button-primary" href="/admin/endpoints/new">New endpoint</NavLink></div>
</section>

<section class="panel">
    <div class="panel-header compact">
        <div>
            <p class="eyebrow">Defined endpoints</p>
            <h2>Reusable delivery targets</h2>
            @if (_options.Count > 0)
            {
                <p class="field-help">@FilteredEndpoints.Count() of @_options.Count endpoints</p>
            }
        </div>
        @if (_options.Count > 0)
        {
            <input class="input endpoint-search" type="search" placeholder="Search endpoints" aria-label="Search endpoints" @bind="_searchTerm" @bind:event="oninput" />
        }
    </div>
    @if (_options.Count == 0)
    {
        <div class="empty-state">
            <h3>No endpoints have been defined.</h3>
            <p class="muted">Create an endpoint to use it as a subscription delivery target.</p>
            <NavLink class="button button-primary" href="/admin/endpoints/new">New endpoint</NavLink>
        </div>
    }
    else if (!FilteredEndpoints.Any())
    {
        <div class="empty-state compact">
            <h3>No matching endpoints.</h3>
            <p class="muted">Try another name, URL, or authentication scheme.</p>
        </div>
    }
    else
    {
        <div class="endpoint-list" role="table" aria-label="Defined endpoints">
            <div class="endpoint-list-header" role="row">
                <span role="columnheader">Endpoint</span>
                <span role="columnheader">Delivery URL</span>
                <span role="columnheader">Authentication</span>
                <span role="columnheader" class="visually-hidden">Actions</span>
            </div>
            @foreach (var endpoint in FilteredEndpoints)
            {
                <article class="endpoint-row" role="row">
                    <strong class="endpoint-name" role="cell">@endpoint.Name</strong>
                    <span class="endpoint-url" role="cell" title="@endpoint.Url">@endpoint.Url</span>
                    <span class="endpoint-auth" role="cell">
                        <span class="badge badge-muted">@(string.IsNullOrWhiteSpace(endpoint.AuthenticationScheme) ? "No authentication" : endpoint.AuthenticationScheme)</span>
                    </span>
                    <div class="endpoint-actions" role="cell">
                        <a class="button button-secondary" href="@($"/admin/endpoints/{endpoint.EndpointId}/edit")">Edit</a>
                        @if (_deleteConfirmEndpointId != endpoint.EndpointId)
                        {
                            <button type="button" class="button button-danger" @onclick="() => BeginEndpointDelete(endpoint.EndpointId)">Delete</button>
                        }
                    </div>
                    @if (_deleteConfirmEndpointId == endpoint.EndpointId)
                    {
                        <div class="endpoint-delete-confirm" role="cell" aria-colspan="4">
                            <div>
                                <strong>Delete @endpoint.Name?</strong>
                                <p class="muted">This removes the endpoint configuration.</p>
                            </div>
                            <div class="endpoint-actions">
                                <button type="button" class="button button-danger" @onclick="() => DeleteEndpointAsync(endpoint.EndpointId)" disabled="@(_deletingEndpointId == endpoint.EndpointId)">
                                    @(_deletingEndpointId == endpoint.EndpointId ? "Deleting..." : "Confirm delete")
                                </button>
                                <button type="button" class="button button-secondary" @onclick="CancelEndpointDelete" disabled="@(_deletingEndpointId == endpoint.EndpointId)">Cancel</button>
                            </div>
                            @if (_deleteError is not null)
                            {
                                <div class="inline-alert danger" role="alert">@_deleteError</div>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<EndpointViewModel> _options = [];
    private string _searchTerm = string.Empty;
    private string? _deleteError;
    private int? _deleteConfirmEndpointId;
    private int? _deletingEndpointId;

    private IEnumerable<EndpointViewModel> FilteredEndpoints
    {
        get
        {
            var term = _searchTerm.Trim();
            if (term.Length == 0) return _options;

            return _options.Where(endpoint =>
                endpoint.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                endpoint.Url.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (endpoint.AuthenticationScheme?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _options = await Admin.GetEndpointOptionsAsync();
        _searchTerm = string.Empty;
        _deleteError = null;
        _deleteConfirmEndpointId = null;
        _deletingEndpointId = null;
    }

    private void BeginEndpointDelete(int endpointId)
    {
        _deleteError = null;
        _deleteConfirmEndpointId = endpointId;
    }

    private void CancelEndpointDelete()
    {
        _deleteError = null;
        _deleteConfirmEndpointId = null;
    }

    private async Task DeleteEndpointAsync(int endpointId)
    {
        _deletingEndpointId = endpointId;
        _deleteError = null;
        try
        {
            if (!await Admin.DeleteEndpointAsync(endpointId))
            {
                _deleteError = "The endpoint could not be deleted.";
                return;
            }

            _options = await Admin.GetEndpointOptionsAsync();
            _deleteConfirmEndpointId = null;
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
        finally
        {
            _deletingEndpointId = null;
        }
    }
}
