@page "/admin/subscriptions/{SubscriptionId}"
@implements IAsyncDisposable

<PageTitle>@(Details?.Subscription.SubscriptionId ?? SubscriptionId)</PageTitle>

<a class="details-back" href="/">← Back to dashboard</a>
<section class="hero details-hero">
    <div class="hero-copy">
        <p class="eyebrow">Subscription</p>
        <h1>@(Details?.Subscription.SubscriptionId ?? SubscriptionId)</h1>
        @if (Details is not null)
        {
            <p class="details-subtitle">
                @(string.IsNullOrWhiteSpace(Details.Subscription.SecondaryIndexName) ? "All streams" : Details.Subscription.SecondaryIndexName)
                <span>·</span> @Details.Subscription.Tag <span>·</span> @Details.Subscription.EndpointUrl
            </p>
        }
        else
        {
            <p class="details-subtitle">Loading subscription details...</p>
        }
    </div>
    @if (Details is not null)
    {
        <div class="hero-actions">
            <a class="button button-secondary" href="@($"/admin/subscriptions/{Details.Subscription.SubscriptionId}/edit")">Edit</a>
            <button class="button button-secondary" @onclick="ToggleStateAsync" disabled="@_busy">
                @(Details.Subscription.Enabled && Details.Subscription.OperationalState == SubscriptionOperationalState.Healthy ? "Stop" : "Start")
            </button>
            <button class="button button-secondary" @onclick="BackfillDailyCommitsAsync" disabled="@_busy">Backfill daily commits</button>
        </div>
    }
</section>

@if (_loading)
{
    <section class="panel loading-panel">
        <div class="skeleton-line w-50"></div>
        <div class="skeleton-line w-80"></div>
        <div class="skeleton-line w-65"></div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel alert-panel">
        <p class="eyebrow">Not found</p>
        <h2>We couldn’t locate that subscription.</h2>
        <p class="muted">@_error</p>
    </section>
}
else if (Details is not null)
{
    <section class="details-summary" aria-label="Subscription summary">
        <div class="details-metric">
            <span>Health</span>
            <strong class="@GetHealthTextClass(Details.Status?.Health)">@DisplayValue(Details.Status?.Health)</strong>
            <small>@(Details.Status?.IsRunning == true ? "Running" : "Not running")</small>
        </div>
        <div class="details-metric">
            <span>Progress</span>
            <strong>@(Details.Status?.ProgressDisplay ?? "n/a")</strong>
            <small>Commit @DisplayValue(Details.Status?.CommitPosition)</small>
        </div>
        <div class="details-metric">
            <span>Parked events</span>
            <strong class="@(Details.ParkedEvents.Count > 0 ? "details-warning" : "details-success")">@Details.ParkedEvents.Count</strong>
            <small>Latest @DisplayDate(Details.Status?.LatestParkedAt)</small>
        </div>
        <div class="details-metric">
            <span>Replay status</span>
            <strong class="@(Details.ReplayStatus?.HasActiveReplaySession == true ? "details-warning" : "details-success")">@(Details.ReplayStatus?.HasActiveReplaySession == true ? "Active" : "Idle")</strong>
            <small>@((Details.ReplayStatus?.ActiveReplaySessionCount ?? 0).ToString(CultureInfo.InvariantCulture)) active sessions</small>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Details.Status?.RuntimeFailureReason) || !string.IsNullOrWhiteSpace(Details.Status?.OperationalReason))
    {
        <div class="details-alert">
            @if (!string.IsNullOrWhiteSpace(Details.Status?.RuntimeFailureReason))
            {
                <span>Worker error: @Details.Status!.RuntimeFailureReason</span>
                <span class="muted">Observed @DisplayDate(Details.Status.RuntimeFailureAt)</span>
            }
            @if (!string.IsNullOrWhiteSpace(Details.Status?.OperationalReason))
            {
                <span>@Details.Status!.OperationalReason</span>
            }
        </div>
    }

    <div class="details-layout">
        <div class="details-main-column">
            <section class="details-section">
                <div class="details-section-heading"><h2>Last delivery</h2><span>Latest attempt</span></div>
                @if (_lastDeliverySnapshot is null)
                {
                    <p class="muted details-empty">No delivery activity yet. The latest attempt will appear here when an event is sent.</p>
                }
                else
                {
                    <div class="delivery-summary-row">
                        <div>
                            <strong>@_lastDeliverySnapshot.EventType</strong>
                            <span class="muted"> · @_lastDeliverySnapshot.StreamName · Event @_lastDeliverySnapshot.EventId</span>
                        </div>
                        <span class="@(string.IsNullOrWhiteSpace(_lastDeliverySnapshot.FailureReason) ? "details-success" : "details-danger")">@_lastDeliverySnapshot.Status</span>
                        <time>@DisplayDate(_lastDeliverySnapshot.DeliveredAt)</time>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_lastDeliverySnapshot.FailureReason))
                    {
                        <p class="delivery-failure-summary">@_lastDeliverySnapshot.FailureReason</p>
                    }
                }
            </section>

            <section class="details-section">
                <div class="details-section-heading"><h2>Configuration</h2><span>Subscription details</span></div>
                <dl class="details-properties">
                    <div><dt>Delivery target</dt><dd title="@Details.Subscription.EndpointUrl">@Details.Subscription.EndpointUrl</dd></div>
                    <div><dt>Index</dt><dd>@(string.IsNullOrWhiteSpace(Details.Subscription.SecondaryIndexName) ? "All streams" : Details.Subscription.SecondaryIndexName)</dd></div>
                    <div><dt>Tag</dt><dd>@Details.Subscription.Tag</dd></div>
                    <div><dt>Enabled</dt><dd>@(Details.Subscription.Enabled ? "Yes" : "No")</dd></div>
                    <div><dt>Operational state</dt><dd class="@GetHealthTextClass(Details.Subscription.OperationalState.ToString())">@Details.Subscription.OperationalState</dd></div>
                    <div><dt>Retry policy</dt><dd>@Details.Subscription.Retry.MaxAttempts attempts · @Details.Subscription.Retry.Delay.TotalSeconds.ToString("0.##", CultureInfo.InvariantCulture) sec</dd></div>
                </dl>
            </section>

            <section class="details-section" id="parked-events">
                <div class="details-section-heading"><h2>Parked events <span class="@(Details.ParkedEvents.Count > 0 ? "details-warning" : "")">· @Details.ParkedEvents.Count</span></h2><span>Newest first</span></div>
                @if (Details.ParkedEvents.Count == 0)
                {
                    <p class="muted details-empty">No parked events. This subscription is currently clear.</p>
                }
                else
                {
                    <div class="parked-replay-action">
                        <div>
                            <strong>Replay all @Details.ParkedEvents.Count parked events</strong>
                            <p>Retries saved events oldest first; successes are removed and failures are parked again. The subscription checkpoint is not rewound.</p>
                            <p class="parked-replay-scope">Single-event retry is unavailable. This action targets all parked events for @Details.Subscription.SubscriptionId.</p>
                        </div>
                        <button type="button" class="button button-primary" @onclick="ReplayAsync"
                                disabled="@(_busy || Details.ReplayStatus?.HasActiveReplaySession == true)">
                            @(Details.ReplayStatus?.HasActiveReplaySession == true ? "Replay in progress" : $"Replay all {Details.ParkedEvents.Count} events")
                        </button>
                    </div>
                    <div class="parked-event-list">
                        @foreach (var parkedEvent in Details.ParkedEvents.OrderByDescending(x => x.ParkedAt))
                        {
                            <article class="parked-event-row">
                                <div class="parked-event-identity">
                                    <strong title="@parkedEvent.EventId">@parkedEvent.EventId</strong>
                                    <span>@parkedEvent.StreamName · @parkedEvent.EventType</span>
                                </div>
                                <p class="failure-reason">@parkedEvent.FailureReason</p>
                                <time>@DisplayDate(parkedEvent.ParkedAt)</time>
                                <div class="parked-event-meta">
                                    <span>@parkedEvent.AttemptCount attempts</span>
                                    <span>@parkedEvent.ContentType</span>
                                    <details class="payload-details">
                                        <summary>Payload · @parkedEvent.Payload.Length bytes</summary>
                                        <pre class="payload-preview">@SubscriptionAdminService.FormatPreview(parkedEvent.Payload)</pre>
                                    </details>
                                </div>
                            </article>
                        }
                    </div>
                    <p class="details-footnote">Each row shows the event identifier, stream, failure, parked time and attempt count. Expand a payload when you need it.</p>
                }
            </section>
        </div>

        <aside class="details-side-column">
            <section class="details-section">
                <div class="details-section-heading"><h2>Checkpoint</h2><span>Subscription</span></div>
                @if (Details.Checkpoint.CommitPosition is null && Details.Checkpoint.ProcessedCount == 0 && string.IsNullOrWhiteSpace(Details.Checkpoint.CheckpointReason))
                {
                    <p class="muted details-empty">No checkpoint recorded yet.</p>
                }
                else
                {
                    <dl class="details-checkpoint-values">
                        <div><dt>Commit position</dt><dd class="details-mono">@DisplayValue(Details.Checkpoint.CommitPosition)</dd></div>
                        <div><dt>Processed</dt><dd>@Details.Checkpoint.ProcessedCount.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                        <div><dt>Reason</dt><dd>@(string.IsNullOrWhiteSpace(Details.Checkpoint.CheckpointReason) ? "n/a" : Details.Checkpoint.CheckpointReason)</dd></div>
                    </dl>
                    <p class="details-footnote">Sourced from <code>SubscriptionCheckpoints</code>.</p>
                }
            </section>

            <section class="details-section">
                <div class="details-section-heading"><h2>Replay checkpoints</h2><span>Daily positions</span></div>
                <div class="details-date-filters">
                    <label><span>From</span><input type="date" class="input" @bind="_fromDate" /></label>
                    <label><span>To</span><input type="date" class="input" @bind="_toDate" /></label>
                    <button class="button button-secondary" @onclick="ApplyFiltersAsync" disabled="@_busy">Apply</button>
                </div>
                @if (Details.DailyPositions.Count == 0)
                {
                    <p class="muted details-empty">No daily positions in this range. Adjust the dates to inspect older checkpoints.</p>
                }
                else
                {
                    <div class="daily-position-list">
                        @foreach (var row in Details.DailyPositions)
                        {
                            <div class="daily-position-row">
                                <div>
                                    <strong>@row.Date.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</strong>
                                    <span>@row.SecondaryIndexName</span>
                                    <small>Commit @DisplayValue(row.CommitPosition)</small>
                                </div>
                                @if (row.CommitPosition is long commitPosition)
                                {
                                    <button type="button" class="button button-secondary" @onclick="() => ReplayFromCheckpointAsync(commitPosition)" disabled="@_busy">Replay from here</button>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        </aside>
    </div>

    @if (!string.IsNullOrWhiteSpace(_toast))
    {
        <section class="panel toast-panel">
            <p class="eyebrow">Update</p>
            <p>@_toast</p>
        </section>
    }
}
@code {
    [Parameter]
    public string SubscriptionId { get; set; } = string.Empty;

    [Inject]
    private SubscriptionAdminService Admin { get; set; } = default!;

    private SubscriptionDetailViewModel? Details;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _toast;
    private SubscriptionDeliverySnapshot? _lastDeliverySnapshot;
    private CancellationTokenSource? _snapshotRefreshCts;
    private Task? _snapshotRefreshTask;
    private DateOnly _fromDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30).Date);
    private DateOnly _toDate = DateOnly.FromDateTime(DateTime.UtcNow.Date);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        await StopSnapshotRefreshAsync();

        try
        {
            var (fromDate, toDate) = ParseRange();
            Details = await Admin.GetDetailAsync(SubscriptionId, fromDate, toDate);
            if (Details is null)
            {
                _error = "The subscription was not found.";
            }
            else
            {
                _fromDate = DateOnly.FromDateTime(Details.FromDate);
                _toDate = DateOnly.FromDateTime(Details.ToDate);
                _lastDeliverySnapshot = await Admin.GetLatestDeliverySnapshotAsync(SubscriptionId);
                StartSnapshotRefreshLoop(SubscriptionId);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var (fromDate, toDate) = ParseRange();
            Details = await Admin.GetDetailAsync(SubscriptionId, fromDate, toDate);
            if (Details is null)
            {
                _error = "The subscription was not found.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReplayAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Admin.ReplayAsync(SubscriptionId);
            _toast = result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackfillDailyCommitsAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Admin.BackfillDailyCommitsAsync(SubscriptionId);
            _toast = result.Message;
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReplayFromCheckpointAsync(long commitPosition)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Admin.ReplayFromCheckpointAsync(SubscriptionId, commitPosition);
            _toast = result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartSnapshotRefreshLoop(string subscriptionId)
    {
        _snapshotRefreshCts = new CancellationTokenSource();
        var cancellationToken = _snapshotRefreshCts.Token;

        _snapshotRefreshTask = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    var snapshot = await Admin.GetLatestDeliverySnapshotAsync(subscriptionId, cancellationToken);
                    await InvokeAsync(() =>
                    {
                        _lastDeliverySnapshot = snapshot;
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }
                catch
                {
                    // Keep trying; a later poll may succeed.
                }
            }
        }, cancellationToken);
    }

    private async Task ToggleStateAsync()
    {
        if (_busy || Details is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var running = Details.Subscription.Enabled && Details.Subscription.OperationalState == SubscriptionOperationalState.Healthy;
            var updated = running
                ? await Admin.StopAsync(Details.Subscription.SubscriptionId)
                : await Admin.StartAsync(Details.Subscription.SubscriptionId);
            _toast = updated
                ? $"{Details.Subscription.SubscriptionId} is now {(running ? "stopped" : "started")}."
                : "The subscription was not found.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _toast = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private (DateTime From, DateTime To) ParseRange()
    {
        return (_fromDate.ToDateTime(TimeOnly.MinValue), _toDate.ToDateTime(TimeOnly.MinValue));
    }

    private static string GetHealthTextClass(string? health) => (health ?? string.Empty).ToLowerInvariant() switch
    {
        "healthy" => "details-success",
        "replaying" => "details-warning",
        "stopped" => "muted",
        "faulted" => "details-danger",
        _ => "muted"
    };

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "n/a" : value;

    private static string DisplayValue(long? value) => value.HasValue ? value.Value.ToString("N0", CultureInfo.InvariantCulture) : "n/a";

    private static string DisplayDate(DateTimeOffset? value) => value is null
        ? "n/a"
        : value.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm", CultureInfo.CurrentCulture);

    private async Task StopSnapshotRefreshAsync()
    {
        if (_snapshotRefreshCts is null)
        {
            return;
        }

        _snapshotRefreshCts.Cancel();

        try
        {
            if (_snapshotRefreshTask is not null)
            {
                await _snapshotRefreshTask;
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _snapshotRefreshCts.Dispose();
            _snapshotRefreshCts = null;
            _snapshotRefreshTask = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopSnapshotRefreshAsync();
}
