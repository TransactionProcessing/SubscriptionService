@page "/admin/subscriptions/new"
@page "/admin/subscriptions/{SubscriptionId}/edit"
<PageTitle>@PageHeading</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Configuration</p>
        <h1>@PageHeading</h1>
        <p class="muted">
            Choose an index and delivery target, then preview matching events before saving.
        </p>
    </div>

    <div class="hero-actions">
        <a class="button button-secondary" href="/">Back to dashboard</a>
    </div>
</section>

@if (_loading)
{
    <section class="panel loading-panel">
        <div class="skeleton-line w-45"></div>
        <div class="skeleton-line w-80"></div>
        <div class="skeleton-line w-60"></div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="panel alert-panel">
        <p class="eyebrow">Not found</p>
        <h2>That subscription does not exist.</h2>
        <p class="muted">@_error</p>
        <a class="button button-primary" href="/">Go back</a>
    </section>
}
else if (_model is not null)
{
    <EditForm Model="@_model" OnValidSubmit="SaveAsync" class="form-card panel subscription-editor-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <nav class="subscription-wizard-steps" aria-label="Subscription setup progress">
            <button type="button" class="wizard-step @(_currentStep == 1 ? "active" : _furthestStep > 1 ? "complete" : null)" aria-current="@(_currentStep == 1 ? "step" : null)" @onclick="() => GoToStep(1)"><span>1</span><strong>Index</strong></button>
            <span class="wizard-connector @(_furthestStep > 1 ? "complete" : null)" aria-hidden="true"></span>
            <button type="button" class="wizard-step @(_currentStep == 2 ? "active" : _furthestStep > 2 ? "complete" : null)" aria-current="@(_currentStep == 2 ? "step" : null)" disabled="@(_furthestStep < 2)" @onclick="() => GoToStep(2)"><span>2</span><strong>Delivery</strong></button>
            <span class="wizard-connector @(_furthestStep > 2 ? "complete" : null)" aria-hidden="true"></span>
            <button type="button" class="wizard-step @(_currentStep == 3 ? "active" : _furthestStep > 3 ? "complete" : null)" aria-current="@(_currentStep == 3 ? "step" : null)" disabled="@(_furthestStep < 3)" @onclick="() => GoToStep(3)"><span>3</span><strong>Advanced</strong></button>
            <span class="wizard-connector @(_furthestStep > 3 ? "complete" : null)" aria-hidden="true"></span>
            <button type="button" class="wizard-step @(_currentStep == 4 ? "active" : null)" aria-current="@(_currentStep == 4 ? "step" : null)" disabled="@(_furthestStep < 4)" @onclick="() => GoToStep(4)"><span>4</span><strong>Preview</strong></button>
        </nav>

        @if (!string.IsNullOrWhiteSpace(_formError))
        {
            <div class="inline-alert">@_formError</div>
        }

        <div class="subscription-editor-layout">
            <div class="subscription-editor-main">
            @if (_currentStep == 1)
            {
            <section class="form-section editor-panel">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Step 1 · Identity</p>
                        <h2>Choose an index</h2>
                        <p class="field-help">Search by name, then select the event stream this subscription should follow.</p>
                    </div>
                </div>

                <label class="field index-search-field">
                    <span class="sr-only">Search indexes</span>
                    <InputText class="input" type="search" placeholder="Search indexes by name…" @bind-Value="_indexSearch" @bind-Value:event="oninput" />
                </label>

                <div class="index-filter-tabs" role="group" aria-label="Filter indexes">
                    <button type="button" class="index-filter-tab @(_indexTypeFilter == "All" ? "active" : null)" aria-pressed="@(_indexTypeFilter == "All")" @onclick="ShowAllIndexes">All indexes <span>@FilteredIndexCount</span></button>
                    <button type="button" class="index-filter-tab @(_indexTypeFilter == "BuiltIn" ? "active" : null)" aria-pressed="@(_indexTypeFilter == "BuiltIn")" @onclick="ShowBuiltInIndexes">Built-in</button>
                    <button type="button" class="index-filter-tab @(_indexTypeFilter == "UserDefined" ? "active" : null)" aria-pressed="@(_indexTypeFilter == "UserDefined")" @onclick="ShowUserDefinedIndexes">User-defined</button>
                </div>

                <div class="index-picker" role="group" aria-label="Secondary index choices">
                    @if (FilteredBuiltInIndexes.Any())
                    {
                        <div class="index-group">
                            <h3 class="index-group-title">Built-in indexes</h3>
                            @foreach (var item in FilteredBuiltInIndexes)
                            {
                                <button type="button" aria-pressed="@IsIndexSelected(item.Name)" class="index-option @(IsIndexSelected(item.Name) ? "selected" : null)" @onclick="() => OnIndexSelectionChanged(item.Name)">
                                    <span class="index-radio" aria-hidden="true"></span>
                                    <span class="index-option-copy"><strong>@item.Name</strong><small>@item.Type · @item.StateOrDefault</small></span>
                                    <span class="@EventStoreIndexPresentation.GetStateBadgeClass(item.State)">@item.StateOrDefault</span>
                                </button>
                            }
                        </div>
                    }
                    @if (FilteredUserIndexes.Any())
                    {
                        <div class="index-group">
                            <h3 class="index-group-title">User-defined indexes</h3>
                            @foreach (var item in FilteredUserIndexes)
                            {
                                <button type="button" aria-pressed="@IsIndexSelected(item.Name)" class="index-option @(IsIndexSelected(item.Name) ? "selected" : null)" @onclick="() => OnIndexSelectionChanged(item.Name)">
                                    <span class="index-radio" aria-hidden="true"></span>
                                    <span class="index-option-copy"><strong>@item.Name</strong><small>@item.Type · @item.StateOrDefault</small></span>
                                    <span class="@EventStoreIndexPresentation.GetStateBadgeClass(item.State)">@item.StateOrDefault</span>
                                </button>
                            }
                        </div>
                    }
                    @if (!FilteredIndexes.Any())
                    {
                        <p class="index-empty">No indexes match “@_indexSearch”. Try another search or enter an index name below.</p>
                    }
                </div>

                <div class="manual-index-toggle">
                    @if (_selectedIndexName != CustomIndexOption)
                    {
                        <button type="button" class="text-button" @onclick="ChooseManualIndex">＋ Enter an index name manually</button>
                    }
                    @if (_selectedIndexName == CustomIndexOption)
                    {
                        <label class="field manual-index-field">
                            <span>Index name</span>
                            <InputText class="input mono" placeholder="Index name to create in KurrentDB" Value="@_model.SecondaryIndexName" ValueChanged="OnSecondaryIndexChanged" ValueExpression="() => _model.SecondaryIndexName" />
                            <small class="field-help">Enter the name of an index you plan to create in KurrentDB.</small>
                        </label>
                    }
                </div>
                @if (!HasIndexSelection)
                {
                    <small class="field-help">Select an index or enter one manually to continue.</small>
                }
                @if (!string.IsNullOrWhiteSpace(_indexOptionsError))
                {
                    <div class="inline-alert danger">@_indexOptionsError</div>
                }
                else if (_indexOptions.Count == 0)
                {
                    <small class="field-help">No indexes are currently available. You can still enter one manually.</small>
                }
            </section>
            }

            @if (_currentStep == 2)
            {
            <section class="form-section editor-panel">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Step 2 · Delivery</p>
                        <h2>Choose where events go</h2>
                    </div>
                </div>

                <div class="source-fields editor-delivery-fields">
                <label class="field">
                    <span>Delivery endpoint</span>
                    <InputSelect TValue="int" class="input" Value="@_model.EndpointId" ValueChanged="OnEndpointChanged" ValueExpression="() => _model.EndpointId">
                        <option value="">Select an endpoint</option>
                        @foreach (var endpoint in _endpointOptions)
                        {
                            <option value="@endpoint.EndpointId">@($"{endpoint.Name} · {endpoint.Url}")</option>
                        }
                    </InputSelect>
                    <small class="field-help">Endpoints are managed separately and include URL and authentication.</small>
                    @if (_endpointOptions.Count == 0)
                    {
                        <a class="button button-secondary" href="/admin/endpoints">Create an endpoint</a>
                    }
                    @if (_model.EndpointId <= 0)
                    {
                        <small class="field-help">Select an endpoint to continue.</small>
                    }
                </label>

                <label class="field">
                    <span>Tag</span>
                    <InputText class="input" Value="@_model.Tag" ValueChanged="OnTagChanged" ValueExpression="() => _model.Tag" />
                    <small class="field-help">Displayed in headers and used by your downstream handler.</small>
                </label>
                </div>
            </section>
            }

            @if (_currentStep == 3)
            {
            <section class="form-section editor-panel">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Step 3 · Optional</p>
                        <h2>Advanced settings</h2>
                        <p class="field-help">The defaults are ready to use. Change retry, checkpoint or event handling if needed.</p>
                    </div>
                </div>

                <div class="two-column">
                    <label class="field">
                        <span>Timeout seconds</span>
                        <InputNumber class="input input-narrow" @bind-Value="_model.RequestTimeoutSeconds" />
                    </label>
                    <label class="field">
                        <span>Max retry count</span>
                        <InputNumber class="input input-narrow" @bind-Value="_model.RetryMaxAttempts" />
                        <small class="field-help">0 means only the initial attempt. Higher values add retries after failures.</small>
                    </label>
                    <label class="field">
                        <span>Retry delay seconds</span>
                        <InputNumber class="input input-narrow" @bind-Value="_model.RetryDelaySeconds" />
                    </label>
                    <label class="field">
                        <span>Checkpoint batch size</span>
                        <InputNumber class="input input-narrow" @bind-Value="_model.CheckpointBatchSize" />
                    </label>
                </div>

                <div class="switch-grid">
                    <label class="switch">
                        <InputCheckbox @bind-Value="_model.Enabled" />
                        <span>
                            <strong>Enabled</strong>
                            <small class="field-help">Uncheck to keep the subscription configured but inactive.</small>
                        </span>
                    </label>
                    <label class="switch">
                        <InputCheckbox @bind-Value="_model.ContinueOnParked" />
                        <span>
                            <strong>Continue on parked</strong>
                            <small class="field-help">Keep processing after a parked event is encountered.</small>
                        </span>
                    </label>
                    <label class="switch">
                        <InputCheckbox @bind-Value="_model.SoftDeleteParked" />
                        <span>
                            <strong>Soft delete parked</strong>
                            <small class="field-help">Keep parked events for audit instead of removing them.</small>
                        </span>
                    </label>
                    <label class="switch">
                        <InputCheckbox @bind-Value="_model.EnableEventLogging" />
                        <span>
                            <strong>Enable event logging</strong>
                            <small class="field-help">Record every delivery attempt, including retries and replays.</small>
                        </span>
                    </label>
                </div>
            </section>
            }

            @if (_currentStep == 4)
            {
            <section class="form-section editor-panel" id="preview">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Step 4 · Preview</p>
                        <h2>Check matching events</h2>
                        <p class="field-help">Preview runs in memory and does not save or start this subscription.</p>
                    </div>
                </div>

                <div class="wizard-review-summary">
                    <div><span>Index</span><strong>@(string.IsNullOrWhiteSpace(_model.SecondaryIndexName) ? "Not selected" : _model.SecondaryIndexName)</strong></div>
                    <div><span>Endpoint</span><strong>@(_endpointOptions.FirstOrDefault(x => x.EndpointId == _model.EndpointId)?.Name ?? "Not selected")</strong></div>
                    <div><span>Tag</span><strong>@(string.IsNullOrWhiteSpace(_model.Tag) ? "None" : _model.Tag)</strong></div>
                </div>

                <div class="filter-row">
                    <label class="field compact-field">
                        <span>Preview count</span>
                        <input class="input" min="1" type="number" value="@_previewCount" @onchange="OnPreviewCountChanged" />
                        <small class="field-help">How many events to collect before the in-memory catch-up stops.</small>
                    </label>

                    <button type="button" class="button button-secondary" @onclick="PreviewAsync" disabled="@(_previewing || _model is null)">
                        @(_previewing ? "Loading preview..." : $"Preview first {_previewCount} events")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <div class="inline-alert danger">@_previewError</div>
                }
                else if (!string.IsNullOrWhiteSpace(_previewMessage))
                {
                    <div class="inline-alert">@_previewMessage</div>
                }

                @if (_previewError is null)
                {
                    @if (_previewEvents.Count == 0)
                    {
                        <p class="muted">@(_previewMessage is null ? "Run the preview to see matching events." : "No events were returned for this index.")</p>
                    }
                    else
                    {
                        <div class="card-stack">
                            @foreach (var previewEvent in _previewEvents)
                            {
                                <article class="parked-card">
                                    <div class="parked-header">
                                        <div>
                                            <strong>@previewEvent.EventId</strong>
                                            <div class="muted small">@previewEvent.StreamName · @previewEvent.EventType</div>
                                        </div>
                                        <div class="muted small">@FormatOccurredAt(previewEvent.OccurredAt)</div>
                                    </div>

                                    <div class="badge-row">
                                        <span class="badge badge-muted">Commit: @FormatCommitPosition(previewEvent.CommitPosition)</span>
                                        <span class="badge badge-info">@previewEvent.ContentType</span>
                                    </div>

                                    <pre class="payload-preview">@SubscriptionAdminService.FormatPreview(previewEvent.Payload)</pre>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
            }
            </div>

            <aside class="generated-id-panel editor-id-panel" aria-live="polite">
                <p class="eyebrow">Live summary</p>
                <h2>Generated subscription ID</h2>
                <p class="field-help">@(IsCreate ? "Updates as your index, endpoint and tag change." : "The saved subscription ID stays fixed while editing.")</p>
                <div class="generated-id-box">
                    <span>Subscription identifier</span>
                    <strong class="generated-subscription-id" aria-live="polite">@(string.IsNullOrWhiteSpace(_model?.SubscriptionId) ? "Choose an index and endpoint" : _model?.SubscriptionId)</strong>
                </div>
                <div class="generated-id-parts">
                    <div><span>Index</span><strong>@(_model?.SecondaryIndexName ?? "—")</strong></div>
                    <div><span>Endpoint</span><strong>@(_endpointOptions.FirstOrDefault(x => x.EndpointId == (_model?.EndpointId ?? 0))?.Name ?? "—")</strong></div>
                    <div><span>Tag</span><strong>@(string.IsNullOrWhiteSpace(_model?.Tag) ? "None" : _model?.Tag)</strong></div>
                </div>
                <p class="field-help">Built from the index name, endpoint name and tag.</p>
                <span class="badge @( (_model?.Enabled ?? false) ? "badge-success" : "badge-muted")">@((_model?.Enabled ?? false) ? "Enabled" : "Disabled")</span>
            </aside>
        </div>

        <div class="form-actions subscription-editor-actions">
            @if (!IsCreate)
            {
                <button type="button" class="button button-danger editor-delete-button" @onclick="ToggleDeleteConfirm" disabled="@_saving">
                    @(_deleteConfirm ? "Confirm delete" : "Delete")
                </button>
            }
            @if (_currentStep > 1)
            {
                <button type="button" class="button button-secondary" @onclick="GoToPreviousStep">Back</button>
            }
            <div class="editor-action-spacer"></div>
            <a class="button button-secondary" href="@BackLink">Cancel</a>
            @if (_currentStep < 4)
            {
                <button type="button" class="button button-primary" @onclick="GoToNextStep" disabled="@(_currentStep == 1 && !HasIndexSelection || _currentStep == 2 && (_model?.EndpointId ?? 0) <= 0)">
                    @(_currentStep == 3 ? "Skip to preview" : "Continue")
                </button>
            }
            else
            {
                <button type="submit" class="button button-primary" disabled="@_saving">
                    @(_saving ? "Saving..." : IsCreate ? "Save subscription" : "Save changes")
                </button>
            }
        </div>

        @if (_deleteConfirm && !IsCreate)
        {
            <div class="inline-alert danger">
                Deleting removes the subscription configuration. Click “Confirm delete” again to proceed.
            </div>
        }
    </EditForm>
}

@code {
    [Parameter]
    public string? SubscriptionId { get; set; }

    [Inject]
    private SubscriptionAdminService Admin { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private SubscriptionEditorModel? _model;
    private string? _error;
    private string? _formError;
    private bool _loading = true;
    private bool _saving;
    private bool _deleteConfirm;
    private IReadOnlyList<EventStoreIndexListItemViewModel> _indexOptions = Array.Empty<EventStoreIndexListItemViewModel>();
    private IReadOnlyList<EndpointViewModel> _endpointOptions = Array.Empty<EndpointViewModel>();
    private string? _indexOptionsError;
    private IReadOnlyList<SubscriptionEvent> _previewEvents = Array.Empty<SubscriptionEvent>();
    private string? _previewError;
    private string? _previewMessage;
    private bool _previewing;
    private int _previewCount = 10;
    private string _selectedIndexName = string.Empty;
    private string _indexSearch = string.Empty;
    private string _indexTypeFilter = "All";
    private int _currentStep = 1;
    private int _furthestStep = 1;
    private bool HasIndexSelection => !string.IsNullOrWhiteSpace(_model?.SecondaryIndexName);

    private IEnumerable<EventStoreIndexListItemViewModel> FilteredIndexes => _indexOptions
        .Where(item => string.IsNullOrWhiteSpace(_indexSearch) || item.Name.Contains(_indexSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(item => _indexTypeFilter == "All" || (_indexTypeFilter == "BuiltIn" ? item.IsBuiltIn : !item.IsBuiltIn));

    private IEnumerable<EventStoreIndexListItemViewModel> FilteredBuiltInIndexes => FilteredIndexes.Where(item => item.IsBuiltIn);
    private IEnumerable<EventStoreIndexListItemViewModel> FilteredUserIndexes => FilteredIndexes.Where(item => !item.IsBuiltIn);
    private int FilteredIndexCount => FilteredIndexes.Count();

    private const string CustomIndexOption = "__custom_index__";

    private bool IsCreate => string.IsNullOrWhiteSpace(SubscriptionId);
    private string PageHeading => IsCreate ? "Create subscription" : $"Edit {SubscriptionId}";
    private string BackLink => IsCreate ? "/" : $"/admin/subscriptions/{SubscriptionId}";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _formError = null;
        _deleteConfirm = false;
        _indexOptionsError = null;
        _previewEvents = Array.Empty<SubscriptionEvent>();
        _previewError = null;
        _previewMessage = null;
        _previewing = false;
        _previewCount = 10;
        _indexSearch = string.Empty;
        _indexTypeFilter = "All";
        _currentStep = 1;
        _furthestStep = 1;

        try
        {
            _model = await Admin.GetEditorModelAsync(IsCreate ? null : SubscriptionId);
            if (_model is null)
            {
                _error = "The subscription was not found.";
                return;
            }

            await LoadIndexOptionsAsync();
            _endpointOptions = await Admin.GetEndpointOptionsAsync();
            _selectedIndexName = _model is not null &&
                _indexOptions.Any(x => string.Equals(x.Name, _model.SecondaryIndexName, StringComparison.OrdinalIgnoreCase))
                ? _model.SecondaryIndexName
                : string.IsNullOrWhiteSpace(_model?.SecondaryIndexName) ? string.Empty : CustomIndexOption;
            SyncGeneratedSubscriptionId();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadIndexOptionsAsync()
    {
        try
        {
            var indexOptionsTask = Admin.GetIndexOptionsAsync();
            var completedTask = await Task.WhenAny(
                indexOptionsTask,
                Task.Delay(TimeSpan.FromSeconds(5)));
            if (completedTask != indexOptionsTask)
            {
                throw new TimeoutException("The index catalog did not respond within 5 seconds.");
            }

            _indexOptions = await indexOptionsTask;
            _indexOptions = EventStoreIndexPresentation.EnsureIndexOption(_indexOptions, _model?.SecondaryIndexName);
        }
        catch (Exception ex)
        {
            _indexOptions = Array.Empty<EventStoreIndexListItemViewModel>();
            _indexOptionsError = $"Unable to load existing indexes right now: {ex.Message}";
        }
    }

    private Task OnIndexSelectionChanged(string selectedIndex)
    {
        if (_model is null)
        {
            return Task.CompletedTask;
        }

        _selectedIndexName = selectedIndex;
        if (selectedIndex == CustomIndexOption)
        {
            _model.SecondaryIndexName = string.Empty;
        }
        else
        {
            var selectedIndexItem = _indexOptions.FirstOrDefault(x =>
                string.Equals(x.Name, selectedIndex, StringComparison.OrdinalIgnoreCase));
            _model.SecondaryIndexName = SubscriptionEditorModel.NormalizeSelectedIndexName(
                selectedIndex,
                selectedIndexItem?.IsBuiltIn ?? false);
        }

        SyncGeneratedSubscriptionId();
        ResetPreview();
        return Task.CompletedTask;
    }

    private void ChooseManualIndex()
    {
        _selectedIndexName = CustomIndexOption;
        if (_model is not null)
        {
            _model.SecondaryIndexName = string.Empty;
            if (IsCreate)
            {
                _model.SubscriptionId = string.Empty;
            }
        }

        SyncGeneratedSubscriptionId();
        ResetPreview();
    }

    private void ShowAllIndexes() => _indexTypeFilter = "All";
    private void ShowBuiltInIndexes() => _indexTypeFilter = "BuiltIn";
    private void ShowUserDefinedIndexes() => _indexTypeFilter = "UserDefined";

    private bool IsIndexSelected(string indexName) =>
        string.Equals(_selectedIndexName, indexName, StringComparison.OrdinalIgnoreCase);

    private void GoToStep(int step)
    {
        if (step >= 1 && step <= _furthestStep)
        {
            _currentStep = step;
            _formError = null;
        }
    }

    private void GoToPreviousStep() => GoToStep(_currentStep - 1);

    private void GoToNextStep()
    {
        if (_currentStep == 1 && !HasIndexSelection)
        {
            _formError = "Choose an index or enter an index name to continue.";
            return;
        }

        if (_currentStep == 2 && (_model is null || _model.EndpointId <= 0))
        {
            _formError = "Choose a delivery endpoint to continue.";
            return;
        }

        _formError = null;
        _currentStep = Math.Min(4, _currentStep + 1);
        _furthestStep = Math.Max(_furthestStep, _currentStep);
    }

    private Task OnSecondaryIndexChanged(string selectedIndex)
    {
        selectedIndex = selectedIndex?.Trim() ?? string.Empty;
        if (_model is null)
        {
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(selectedIndex))
        {
            _model.SecondaryIndexName = string.Empty;
            SyncGeneratedSubscriptionId();
            return Task.CompletedTask;
        }

        _model.SecondaryIndexName = SubscriptionEditorModel.NormalizeManuallyEnteredIndexName(
            selectedIndex,
            _indexOptions.Where(x => x.IsBuiltIn).Select(x => x.Name));
        SyncGeneratedSubscriptionId();
        ResetPreview();

        return Task.CompletedTask;
    }

    private void ResetPreview()
    {
        _previewEvents = Array.Empty<SubscriptionEvent>();
        _previewError = null;
        _previewMessage = null;
    }

    private Task OnEndpointChanged(int endpointId)
    {
        if (_model is not null)
        {
            _model.EndpointId = endpointId;
            SyncGeneratedSubscriptionId();
        }

        return Task.CompletedTask;
    }

    private Task OnTagChanged(string tag)
    {
        if (_model is not null)
        {
            _model.Tag = tag;
            SyncGeneratedSubscriptionId();
        }

        return Task.CompletedTask;
    }

    private void SyncGeneratedSubscriptionId()
    {
        if (!IsCreate || _model is null)
        {
            return;
        }

        var endpoint = _endpointOptions.FirstOrDefault(x => x.EndpointId == _model.EndpointId);
        if (endpoint is not null && !string.IsNullOrWhiteSpace(_model.SecondaryIndexName))
        {
            _model.SubscriptionId = SubscriptionEditorModel.BuildGeneratedSubscriptionId(_model.SecondaryIndexName, endpoint.Name, _model.Tag);
        }
        else
        {
            _model.SubscriptionId = string.Empty;
        }
    }

    private void OnPreviewCountChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (int.TryParse(value, out var count) && count > 0)
        {
            _previewCount = count;
        }
    }

    private async Task PreviewAsync()
    {
        if (_model is null)
        {
            return;
        }

        var indexName = _model.SecondaryIndexName.Trim();
        if (string.IsNullOrWhiteSpace(indexName))
        {
            _previewError = "Please provide a secondary index name before previewing events.";
            _previewMessage = null;
            _previewEvents = Array.Empty<SubscriptionEvent>();
            return;
        }

        _previewCount = Math.Max(1, _previewCount);
        _previewing = true;
        _previewError = null;
        _previewMessage = null;
        _previewEvents = Array.Empty<SubscriptionEvent>();

        try
        {
            _previewEvents = await Admin.PreviewEventsAsync(indexName, _previewCount);
            _previewMessage = _previewEvents.Count == 0
                ? $"No events were returned for {indexName}."
                : $"Loaded {_previewEvents.Count} preview event{(_previewEvents.Count == 1 ? string.Empty : "s")} for {indexName}.";
        }
        catch (Exception ex)
        {
            _previewError = ex.Message;
        }
        finally
        {
            _previewing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        _formError = null;

        try
        {
            var selectedEndpoint = _endpointOptions.FirstOrDefault(x => x.EndpointId == _model.EndpointId);
            if (selectedEndpoint is not null)
            {
                _model.EndpointUrl = selectedEndpoint.Url;
            }
            SyncGeneratedSubscriptionId();
            if (!_model.TryCreateSubscription(out var subscription, out var error) || subscription is null)
            {
                _formError = error;
                return;
            }

            await Admin.SaveAsync(subscription);
            Navigation.NavigateTo($"/admin/subscriptions/{subscription.SubscriptionId}");
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatCommitPosition(long? commitPosition) =>
        commitPosition?.ToString(CultureInfo.InvariantCulture) ?? "n/a";

    private static string FormatOccurredAt(DateTimeOffset occurredAt) =>
        occurredAt.ToString("g", CultureInfo.CurrentCulture);

    private async Task ToggleDeleteConfirm()
    {
        if (_model is null || IsCreate)
        {
            return;
        }

        if (!_deleteConfirm)
        {
            _deleteConfirm = true;
            return;
        }

        _saving = true;

        try
        {
            if (await Admin.DeleteAsync(_model.SubscriptionId))
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _formError = "The subscription could not be deleted.";
            }
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
