    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "SubscriptionService": {
    "StartSubscriptionsOnStartup": true,
    "ReplayPauseTimeoutSeconds": 30
  },
