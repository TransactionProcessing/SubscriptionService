<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">
  <targets async="true">
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}" />
    <target xsi:type="File"
            name="rollingFile"
            fileName="${basedir}/logs/catchup-service-${shortdate}.log"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}"
            achivefileName="${basedir}/logs/catchup-service-${shortdate}.{#####}.log"
			archiveAboveSize="104857600"
            archiveNumbering="Sequence"
            concurrentWrites="true"
            keepFileOpen="false"
            maxArchiveFiles="2"/>
  </targets>
  <rules>
    <logger name="CatchupService.*" minlevel="Info" writeTo="console,rollingFile" final="true" />
    <logger name="*" minlevel="Warn" writeTo="console,rollingFile" />
  </rules>
</nlog>
